{
  "name": "vexonyx",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=22 <23" },
  "workspaces": ["apps/*", "packages/*", "services/*", "workers/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@vexonyx/web",
    "build": "npm run build --workspace=@vexonyx/web",
    "lint": "npm run lint --workspace=@vexonyx/web",
    "typecheck": "npm run typecheck --workspace=@vexonyx/web",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "supabase": "2.101.0"
  }
}
