# Public application URL
NEXT_PUBLIC_APP_URL=https://www.vexonyx.com

# Search engine ownership verification (public tokens only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Resend transactional email
RESEND_API_KEY=re_REPLACE_ME
WAITLIST_FROM_EMAIL=VEXONYX <info@vexonyx.com>
TRANSACTIONAL_FROM_EMAIL=VEXONYX <info@vexonyx.com>

# Stripe billing (server only; checkout/webhooks fail closed while missing)
STRIPE_SECRET_KEY=sk_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Internal workers (server only). Prefer a separate high-entropy value per environment.
WORKER_SHARED_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
# Vercel Cron can use CRON_SECRET instead when configured.
CRON_SECRET=REPLACE_WITH_HIGH_ENTROPY_SECRET
